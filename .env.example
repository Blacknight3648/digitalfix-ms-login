# ==============================================================================
# DIGITALFIX MS-LOGIN - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y completa con tus valores reales
# ==============================================================================

PORT=8081
SERVER_PORT=8081

# Base de Datos Oracle Autonomous (OCI) con Wallet mTLS
# TNS_ADMIN=./wallet apunta a la carpeta wallet en la raiz del microservicio.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<alias>_high?TNS_ADMIN=./wallet
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=tu_password_admin

# Microsoft Entra ID (Azure AD) - Resource Server
AZURE_TENANT_ID=tu_azure_tenant_id
AZURE_CLIENT_ID=tu_azure_client_id

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ms-user (rol de negocio para la autorizacion por rol)
MS_USER_URL=http://localhost:8082
